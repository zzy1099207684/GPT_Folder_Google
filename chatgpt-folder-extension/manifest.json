{
  "manifest_version": 3,
  "name": "ChatGPT Folder,Font,Prompt,Pin, Batch Delete",
  "version": "2.1.8",
  "description": "a simple and great tool for chatgpt website",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content.js", "batch_delete.js","background.js","session_prompt_menu.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
