{
  "manifest_version": 3,
  "name": "Better ChatGPT",
  "version": "2.1.9.6",
  "description": "The plugin allows you to easily group, favorite, pin, bulk manipulate chats, and switch input styles.",
  "icons": {
    "128": "ico.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js",
        "batch_delete.js",
        "background.js",
        "session_prompt_menu.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
